<!-- Authored by Codex. A build-specific, per-user PDF association experiment.
     Default: read-only hash validation. /p:AttemptSet=true explicitly attempts
     the authorized docboxtest.pdf change. Does not change system protection. -->
<Project DefaultTargets="Probe" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <AttemptSet Condition="'$(AttemptSet)' == ''">false</AttemptSet>
    <PermitHashRepair Condition="'$(PermitHashRepair)' == ''">false</PermitHashRepair>
    <ReportFile>$(MSBuildThisFileDirectory)..\evidence\msbuild-latest-probe.json</ReportFile>
    <TaskFactoryAssembly Condition="'$(TaskFactoryAssembly)' == '' and Exists('$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll')">$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll</TaskFactoryAssembly>
    <TaskFactoryAssembly Condition="'$(TaskFactoryAssembly)' == ''">$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll</TaskFactoryAssembly>
  </PropertyGroup>
  <UsingTask TaskName="LatestAssociationProbe" TaskFactory="CodeTaskFactory" AssemblyFile="$(TaskFactoryAssembly)">
    <ParameterGroup>
      <AttemptSet ParameterType="System.Boolean" />
      <PermitHashRepair ParameterType="System.Boolean" />
      <ReportFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="System.Web.Extensions" />
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.InteropServices;
using System.Security.AccessControl;
using System.Security.Cryptography;
using System.Security.Principal;
using System.Text;
using System.Web.Script.Serialization;
using Microsoft.Win32;
using Microsoft.Build.Framework;

public class LatestAssociationProbe : Microsoft.Build.Utilities.Task
{
    public bool AttemptSet { get; set; }
    public bool PermitHashRepair { get; set; }
    [Required] public string ReportFile { get; set; }
    [StructLayout(LayoutKind.Sequential)]
    public struct FileTime { public uint Low; public uint High; }
    [StructLayout(LayoutKind.Sequential)]
    public struct SystemTime { public ushort Year, Month, Weekday, Day, Hour, Minute, Second, Milliseconds; }
    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
    static extern IntPtr LoadLibrary(string path);
    [DllImport("kernel32.dll")]
    static extern bool FileTimeToSystemTime(ref FileTime time, out SystemTime system);
    [DllImport("advapi32.dll", CharSet=CharSet.Unicode)]
    static extern int RegQueryInfoKey(IntPtr key, IntPtr a, IntPtr b, IntPtr c, IntPtr d, IntPtr e, IntPtr f,
        IntPtr g, IntPtr h, IntPtr i, IntPtr j, out FileTime lastWrite);
    [DllImport("shell32.dll")]
    static extern void SHChangeNotify(uint eventId, uint flags, IntPtr first, IntPtr second);
    [UnmanagedFunctionPointer(CallingConvention.Winapi)]
    delegate int GetMachine(out IntPtr result);
    [UnmanagedFunctionPointer(CallingConvention.Winapi, CharSet=CharSet.Unicode)]
    delegate int Generate(uint version, string machine, string sid, string extension, string progId,
        ref SystemTime timestamp, out IntPtr result);
    static FileTime KeyTime(RegistryKey key) {
        FileTime time;
        int error = RegQueryInfoKey(key.Handle.DangerousGetHandle(), IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero,
            IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, out time);
        if (error != 0) throw new System.ComponentModel.Win32Exception(error);
        return time;
    }
    public override bool Execute()
    {
        const string latest = @"Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\UserChoiceLatest";
        const string target = "docboxtest.pdf";
        var report = new Dictionary<string, object>();
        report["attempt_set"] = AttemptSet;
        report["permit_hash_repair"] = PermitHashRepair;
        report["completed_registry_writes"] = 0;
        string stage = "preflight";
        bool success = false;
        try {
            report["host_executable"] = System.Diagnostics.Process.GetCurrentProcess().MainModule.FileName;
            report["process_bits"] = IntPtr.Size * 8;
            var buildAssemblies = new List<string>();
            foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
                if (assembly.GetName().Name.StartsWith("Microsoft.Build", StringComparison.Ordinal))
                    buildAssemblies.Add(assembly.Location);
            report["loaded_build_assemblies"] = buildAssemblies;
            if (!Environment.Is64BitProcess) throw new InvalidOperationException("Use the amd64 MSBuild host");
            var identity = WindowsIdentity.GetCurrent();
            if (new WindowsPrincipal(identity).IsInRole(WindowsBuiltInRole.Administrator))
                throw new InvalidOperationException("Use a non-elevated process");
            string sid = identity.User.Value;
            string dll = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Windows), @"System32\windows.storage.dll");
            string digest;
            using (var sha = SHA256.Create()) using (var stream = File.OpenRead(dll))
                digest = BitConverter.ToString(sha.ComputeHash(stream)).Replace("-", "").ToLowerInvariant();
            if (digest != "8d6ac2b451af71e913665c8459935ac862e219458f0962c99f3a3d48ab9c251b")
                throw new InvalidOperationException("System DLL differs from the analyzed build");
            report["dll_sha256"] = digest;
            uint version;
            using (var machineHive = RegistryKey.OpenBaseKey(RegistryHive.LocalMachine, RegistryView.Registry64))
            using (var protectedKey = machineHive.OpenSubKey(@"SOFTWARE\Microsoft\Windows\CurrentVersion\SystemProtectedUserData\" + sid + @"\AnyoneRead\AppDefaults"))
                version = Convert.ToUInt32(protectedKey.GetValue("HashVersion"));
            if (version != 1) throw new InvalidOperationException("Unvalidated hash version");
            IntPtr module = LoadLibrary(dll);
            if (module == IntPtr.Zero) throw new System.ComponentModel.Win32Exception(Marshal.GetLastWin32Error());
            var getMachine = (GetMachine)Marshal.GetDelegateForFunctionPointer(new IntPtr(module.ToInt64() + 0x6289FC), typeof(GetMachine));
            var generate = (Generate)Marshal.GetDelegateForFunctionPointer(new IntPtr(module.ToInt64() + 0x628D98), typeof(Generate));
            IntPtr machinePointer;
            Marshal.ThrowExceptionForHR(getMachine(out machinePointer));
            string machineId = Marshal.PtrToStringUni(machinePointer);
            Marshal.FreeCoTaskMem(machinePointer);
            using (var hashKey = Registry.CurrentUser.OpenSubKey(latest, RegistryKeyPermissionCheck.ReadWriteSubTree,
                       RegistryRights.ReadKey | RegistryRights.SetValue))
            using (var progKey = Registry.CurrentUser.OpenSubKey(latest + @"\ProgId", RegistryKeyPermissionCheck.ReadWriteSubTree,
                       RegistryRights.ReadKey | RegistryRights.SetValue)) {
                if (hashKey == null || progKey == null) throw new InvalidOperationException("Latest structure is absent");
                string beforeId = (string)progKey.GetValue("ProgId");
                string beforeHash = (string)hashKey.GetValue("Hash");
                FileTime beforeTime = KeyTime(progKey);
                report["before_prog_id"] = beforeId;
                report["before_hash"] = beforeHash;
                Func<string, string> calculate = delegate(string id) {
                    FileTime time = KeyTime(progKey);
                    SystemTime timestamp;
                    if (!FileTimeToSystemTime(ref time, out timestamp)) throw new InvalidOperationException("Invalid timestamp");
                    IntPtr pointer;
                    Marshal.ThrowExceptionForHR(generate(version, machineId, sid, ".pdf", id, ref timestamp, out pointer));
                    try { return Marshal.PtrToStringUni(pointer); }
                    finally { Marshal.FreeCoTaskMem(pointer); }
                };
                report["before_hash_matches"] = calculate(beforeId) == beforeHash;
                if (!(bool)report["before_hash_matches"] && !(AttemptSet && PermitHashRepair && beforeId == target))
                    throw new InvalidOperationException("Existing hash did not match");
                try {
                    if (AttemptSet) {
                        stage = "set_latest_progid";
                        progKey.SetValue("ProgId", target, RegistryValueKind.String);
                        report["completed_registry_writes"] = 1;
                        stage = "set_latest_hash";
                        hashKey.SetValue("Hash", calculate(target), RegistryValueKind.String);
                        report["completed_registry_writes"] = 2;
                        SHChangeNotify(0x08000000, 0x1000, IntPtr.Zero, IntPtr.Zero);
                    }
                    success = !AttemptSet || ((string)progKey.GetValue("ProgId") == target && (string)hashKey.GetValue("Hash") == calculate(target));
                }
                finally {
                    report["after_prog_id"] = progKey.GetValue("ProgId");
                    report["after_hash"] = hashKey.GetValue("Hash");
                    FileTime afterTime = KeyTime(progKey);
                    report["latest_values_unchanged"] = (string)report["after_prog_id"] == beforeId && (string)report["after_hash"] == beforeHash;
                    report["latest_timestamp_unchanged"] = afterTime.Low == beforeTime.Low && afterTime.High == beforeTime.High;
                }
            }
        }
        catch (Exception error) {
            report["failure_stage"] = stage;
            report["error_type"] = error.GetType().FullName;
            report["error"] = error.Message;
            report["hresult"] = "0x" + error.HResult.ToString("x8");
        }
        report["write_probe_success"] = success;
        report["limitation"] = "Build-specific research experiment; Shell verification is separate.";
        string json = new JavaScriptSerializer().Serialize(report);
        File.WriteAllText(ReportFile, json + "\n", new UTF8Encoding(false));
        Log.LogMessage(MessageImportance.High, json);
        if (!success) Log.LogError("Latest association probe failed at " + stage);
        return success;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="Probe">
    <LatestAssociationProbe AttemptSet="$(AttemptSet)" PermitHashRepair="$(PermitHashRepair)" ReportFile="$(ReportFile)" />
  </Target>
</Project>
